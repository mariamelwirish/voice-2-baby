# ─────────────────────────────────────────────────────────────
# client/.env  — frontend (React/Vite) configuration
# Copy to client/.env for local dev. Only VITE_-prefixed vars are
# exposed to the browser. Never put secrets here.
# ─────────────────────────────────────────────────────────────

# Base URL the frontend uses to call the API.
#
# LOCAL DEV: keep this a RELATIVE path. Requests then go through the Vite dev
# proxy (client/vite.config.js) to http://localhost:3000 — same-origin, so no
# CORS and the Vite port doesn't matter.
VITE_API_URL=/api/v1

# PRODUCTION: set the absolute API URL in client/.env.production instead, e.g.
# VITE_API_URL=https://voice2baby.com/api/v1
