{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Effect": "Allow",
      "Action": "iot:Connect",
      "Resource": "arn:aws:iot:REGION_PLACEHOLDER:ACCOUNT_PLACEHOLDER:client/*"
    },
    {
      "Effect": "Allow",
      "Action": ["iot:Publish", "iot:Receive"],
      "Resource": [
        "arn:aws:iot:REGION_PLACEHOLDER:ACCOUNT_PLACEHOLDER:topic/$aws/certificates/create/*",
        "arn:aws:iot:REGION_PLACEHOLDER:ACCOUNT_PLACEHOLDER:topic/$aws/provisioning-templates/nicu-fleet-template/provision/*"
      ]
    },
    {
      "Effect": "Allow",
      "Action": "iot:Subscribe",
      "Resource": [
        "arn:aws:iot:REGION_PLACEHOLDER:ACCOUNT_PLACEHOLDER:topicfilter/$aws/certificates/create/*",
        "arn:aws:iot:REGION_PLACEHOLDER:ACCOUNT_PLACEHOLDER:topicfilter/$aws/provisioning-templates/nicu-fleet-template/provision/*"
      ]
    }
  ]
}
