# ─────────────────────────────────────────────────────────────
# .env (repo root)  — used by docker-compose.yaml for LOCAL DEV
# Copy to .env before running `docker compose up`. Never commit .env.
# These values seed the local MySQL container. Keep DB_NAME / DB_USER /
# DB_PASSWORD identical to the ones in server/.env so the app can connect.
# ─────────────────────────────────────────────────────────────

DB_NAME=remote_reading
DB_USER=admin
DB_PASSWORD=your_db_password_here

# Root password for the local MySQL container (local only — pick anything).
MYSQL_ROOT_PASSWORD=your_mysql_root_password_here
