# ─────────────────────────────────────────────────────────────
# server/.env  — backend (Node/Express) configuration
# Copy to server/.env and fill in real values. Never commit .env.
# ─────────────────────────────────────────────────────────────

# ── Server ──
# Port the API listens on. Client dev proxy expects 3000 (see client/vite.config.js).
PORT=3000
# development | production. Affects logging/behaviour only.
NODE_ENV=development

# ── JWT (auth tokens) ──
# Secret used to sign/verify login tokens. MUST be a long random string.
# Generate one:  node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=your_long_random_jwt_secret_here
# How long a login stays valid (e.g. 8h, 1d, 30m).
JWT_EXPIRES_IN=8h

# ── Database (MySQL) ──
# Local Docker MySQL: use 127.0.0.1. Production: the RDS endpoint.
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=remote_reading
DB_USER=admin
DB_PASSWORD=your_db_password_here
# Set to false to skip auto-migrations on server startup (default: run them).
RUN_MIGRATIONS=true

# ── AWS ──
AWS_REGION=us-east-1
AWS_S3_BUCKET=remote-reading-audio
# LOCAL DEV ONLY: point S3/SES at LocalStack. Leave UNSET in production so the
# SDK uses real AWS endpoints. (docker-compose runs LocalStack on 4566.)
# AWS_ENDPOINT_URL=http://localhost:4566
# AWS credentials. Locally: any dummy values work against LocalStack.
# Production: use a real IAM key/secret, OR omit both and rely on the EC2
# instance IAM role (preferred in prod).
AWS_ACCESS_KEY_ID=your_aws_access_key_id
AWS_SECRET_ACCESS_KEY=your_aws_secret_access_key

# ── SES (transactional email: invites, password resets) ──
# Verified sender identity in SES.
SES_SENDER_EMAIL=remotereading@hotmail.com

# ── IoT Core (device MQTT: play commands + status) ──
# Your account's AWS IoT ATS data endpoint (IoT Core → Settings → Device data endpoint).
AWS_IOT_ENDPOINT=your_iot_endpoint_here

# ── Fleet self-provisioning ──
# Shared secret the pre-provisioning Lambda sends in the x-provision-secret
# header to POST /api/v1/devices/provision. Long random string.
DEVICE_PROVISION_SECRET=your_long_random_provisioning_secret_here

# ── Application URLs ──
# Base URL of the frontend — used to build invite/reset links in emails.
FRONTEND_URL=http://localhost:5173
# Comma-separated list of origins allowed by CORS (defaults to http://localhost:5173).
ALLOWED_ORIGINS=http://localhost:5173
