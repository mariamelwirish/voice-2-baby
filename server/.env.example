# Server
PORT=3000
NODE_ENV=development

# JWT
JWT_SECRET=your_jwt_secret_here
JWT_EXPIRES_IN=8h

# Database
DB_HOST=your_rds_endpoint_here
DB_PORT=3306
DB_NAME=remote_reading
DB_USER=admin
DB_PASSWORD=your_db_password_here

# AWS
AWS_REGION=us-east-1
AWS_S3_BUCKET=remote-reading-audio

# SES
SES_SENDER_EMAIL=remotereading@hotmail.com

# IoT Core
IOT_ENDPOINT=your_iot_endpoint_here

# Fleet self-provisioning: shared secret the pre-provisioning Lambda sends in the
# x-provision-secret header to POST /api/v1/devices/provision. Long random string.
DEVICE_PROVISION_SECRET=your_long_random_provisioning_secret_here

# Application URLs
FRONTEND_URL=your_frontend_url_here
API_URL=your_api_url_here
ALLOWED_ORIGINS=http://localhost:5173